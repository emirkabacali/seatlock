# Copy this file to .env and adjust the values. Never commit .env.
# Docker Compose reads .env automatically; the application imports it on startup
# (spring.config.import in application.yml). Real environment variables take precedence.

# PostgreSQL container (docker-compose.yml)
POSTGRES_DB=seatlock
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Redis container (docker-compose.yml) and application
REDIS_HOST=localhost
REDIS_PORT=6379

# Application (src/main/resources/application.yml)
DB_URL=jdbc:postgresql://localhost:5433/seatlock
DB_USERNAME=seatlock
DB_PASSWORD=change-me

# JWT signing secret: at least 32 bytes. Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=
# Token lifetime (ISO-8601 duration)
JWT_TTL=PT1H

# Optional: an ADMIN account created on startup if it does not exist
ADMIN_EMAIL=admin@seatlock.local
ADMIN_PASSWORD=change-me-admin
