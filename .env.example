# Copy this file to .env and adjust the values. Never commit .env.

# PostgreSQL container (docker-compose.yml)
POSTGRES_DB=seatlock
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Application (src/main/resources/application.yml)
DB_URL=jdbc:postgresql://localhost:5433/seatlock
DB_USERNAME=seatlock
DB_PASSWORD=change-me
